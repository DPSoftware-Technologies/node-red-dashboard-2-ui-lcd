{
    "name": "@dpsoftware/node-red-dashboard-2-ui-lcd",
    "version": "1.3",
    "description": "Character LCD and Graphic LCD for Node-Red Dashboard 2",
    "keywords": [
        "node-red",
        "node-red-dashboard-2",
        "lcd",
        "graphic-lcd"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DPSoftware-Foundation/node-red-dashboard-2-ui-lcd.git"
    },
    "license": "Apache-2.0",
    "author": {
        "name": "DPSoftware Foundation",
        "url": "https://damp11113.xyz"
    },
    "exports": {
        "import": "./resources/ui-lcd.esm.js",
        "require": "./resources/ui-lcd.umd.js"
    },
    "files": [
        "examples/*",
        "nodes/*",
        "ui/*",
        "resources/*"
    ],
    "scripts": {
        "build": "vite build --mode ui-lcd && vite build --mode ui-glcd",
        "build:dev": "NODE_ENV=development vite build --mode ui-lcd && NODE_ENV=development vite build --mode ui-glcd",
        "dev": "NODE_ENV=development vite build --watch --mode ui-lcd",
        "dev:glcd": "NODE_ENV=development vite build --watch --mode ui-glcd",
        "dev:prod": "vite build --watch --mode ui-lcd",
        "lint": "npm run lint:js && npm run lint:package",
        "lint:fix": "npm run lint:js:fix && npm run lint:package:fix",
        "lint:js": "eslint --ext .js,.vue,.cjs,.mjs .",
        "lint:js:fix": "yarn lint:js --fix",
        "lint:package": "sort-package-json --check 'package.json'",
        "lint:package:fix": "sort-package-json 'package.json'"
    },
    "dependencies": {
        "char-lcd": "github:damp11113/char-lcd-plus",
        "vue": "^3.3.8",
        "vuex": "^4.1.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^4.5.0",
        "eslint": "^8.53.0",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.29.0",
        "eslint-plugin-n": "^16.3.1",
        "eslint-plugin-vue": "^9.18.1",
        "vite": "^5.0.13",
        "vite-plugin-css-injected-by-js": "^3.3.0",
        "vite-plugin-static-copy": "^1.0.6"
    },
    "engines": {
        "node": ">=14"
    },
    "node-red": {
        "version": ">=3.0.0",
        "nodes": {
            "ui-lcd": "nodes/ui-lcd.js",
            "ui-glcd": "nodes/ui-glcd.js"
        }
    },
    "node-red-dashboard-2": {
        "version": "1.0.0",
        "widgets": {
            "ui-lcd": {
                "output": "ui-lcd.umd.js",
                "component": "UILCD"
            },
            "ui-glcd": {
                "output": "ui-glcd.umd.js",
                "component": "UIGraphicLCD"
            }
        }
    }
}
