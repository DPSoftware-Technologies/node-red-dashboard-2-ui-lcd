    {
        "id": "c0de000000000017",
        "type": "function",
        "z": "c0de000000000001",
        "name": "Clock every second",
        "func": "const now = new Date();\nconst cx = 32;\nconst cy = 32;\nconst r = 28;\nconst hand = (angle, length) => ({\n    cmd: 'line',\n    args: [cx, cy, Math.round(cx + length * Math.sin(angle)), Math.round(cy - length * Math.cos(angle))]\n});\n\nconst commands = [{ cmd: 'circle', x: cx, y: cy, r }];\nfor (let i = 0; i < 12; i++) {\n    const angle = i * Math.PI / 6;\n    commands.push({ cmd: 'pixel', x: Math.round(cx + (r - 4) * Math.sin(angle)), y: Math.round(cy - (r - 4) * Math.cos(angle)) });\n}\nconst hours = now.getHours() % 12 + now.getMinutes() / 60;\ncommands.push(hand(hours * Math.PI / 6, 14));\ncommands.push(hand(now.getMinutes() * Math.PI / 30, 22));\ncommands.push(hand(now.getSeconds() * Math.PI / 30, 26));\ncommands.push({ cmd: 'text', x: 72, y: 28, text: now.toTimeString().slice(0, 8) });\n\nmsg.payload = commands;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 740,
        "wires": [
